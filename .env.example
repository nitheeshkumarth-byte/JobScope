# Private dashboard on this computer.
HOST=127.0.0.1
JOBSCOPE_LOCAL_MODE=1
# Set APP_URL explicitly if using a reverse proxy with public email callbacks.
APP_URL=

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_NUM_CTX=8192
AGENT_SUMMARY_MODE=template
RESUME_EXTRACT_MODE=strict
JOB_DAYS_BACK=60
JOB_MAX_RESULTS=10
JOBSCOPE_MANUAL_WALL=auto

# Optional integrations.
GITHUB_TOKEN=
# Web application OAuth client JSON for Google sign-in and per-candidate Gmail.
GOOGLE_WEB_OAUTH_CREDENTIALS=client_secret.web.json
# Fernet key used to encrypt Gmail refresh tokens at rest.
JOBSCOPE_GOOGLE_TOKEN_KEY=
GMAIL_OAUTH_CREDENTIALS=client_secret.json
GMAIL_OAUTH_TOKEN_FILE=gmail_oauth_token.json
# Optional verified JobScope email allowed to use the local Gmail connection.
JOBSCOPE_GMAIL_USER=
GOOGLE_FORMS_REDIRECT_URI=
SCREEN_TOKEN=

# Optional SMTP. Leave SMTP_HOST empty for a private installation without mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
AUTH_DEV_LINKS=0
