+"""Recruiter hiring loop: company scoping, job edit, interviews, tasks."""
+import auth
+
+
+def test_hiring_loop_is_scoped_to_the_company():
+    rec = auth.create_user("rec@x.com", "pw12345678", role="recruiter")
+    other = auth.create_user("rec2@x.com", "pw12345678", role="recruiter")
+    cand = auth.create_user("cand@x.com", "pw12345678")
+    co = auth.create_company("Acme", created_by=rec["id"])
+    co2 = auth.create_company("Other", created_by=other["id"])
+
+    auth.create_recruiter_profile(rec["id"], company_id=co["id"], title="HR")
+    auth.create_recruiter_profile(rec["id"])  # a partial save must keep company and title
+    prof = auth.get_recruiter_profile(rec["id"])
+    assert prof["company_id"] == co["id"] and prof["title"] == "HR"
+
+    job = auth.create_job(co["id"], rec["id"], {"title": "Dev", "description": "d"})
+    job = auth.update_job(job["id"], {"status": "published", "required_skills": ["py"]})
+    assert job["status"] == "published" and job["description"] == "d"
+
+    app = auth.apply_to_job(job["id"], cand["id"])
+    assert auth.list_company_applications(co["id"])[0]["candidate_email"] == "cand@x.com"
+    assert auth.list_company_applications(co2["id"]) == []
+    assert not auth.set_company_application_status(co2["id"], app["id"], "hired")
+    assert auth.set_company_application_status(co["id"], app["id"], "shortlisted")
+
+    data = {"application_id": app["id"], "scheduled_at": "2026-12-01T10:00"}
+    assert auth.create_interview(co2["id"], rec["id"], data) is None
+    iv = auth.create_interview(co["id"], rec["id"], data)
+    assert auth.list_company_applications(co["id"])[0]["status"] == "interview_scheduled"
+    assert auth.update_interview(co2["id"], iv["id"], {"status": "completed"}) is None
+    assert auth.update_interview(co["id"], iv["id"], {"status": "completed"})["status"] == "completed"
+
+    task = auth.create_task(rec["id"], co["id"], {"title": "Call"})
+    assert auth.update_task(other["id"], task["id"], {"status": "completed"}) is None
+    assert auth.update_task(rec["id"], task["id"], {"status": "completed"})["status"] == "completed"
+    assert auth.delete_task(rec["id"], task["id"])
